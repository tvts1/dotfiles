general {
    hide_cursor = true
}

background {
    monitor =
    path = {{CURRENT_WALLPAPER_LINK}}
    color = rgba(24, 25, 38, 1.0)

    blur_passes = 3
    blur_size = 7
    brightness = 0.7
}

label {
    monitor =

    text = $TIME
    font_size = 72
    font_family = sans-serif

    position = 0, 120
    halign = center
    valign = center
}

label {
    monitor =

    text = Olá, $USER
    font_size = 24
    font_family = sans-serif

    position = 0, 35
    halign = center
    valign = center
}

input-field {
    monitor =

    size = 300, 55
    outline_thickness = 2

    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true

    placeholder_text = Digite sua senha...
    fail_text = Senha incorreta

    position = 0, -80
    halign = center
    valign = center
}
