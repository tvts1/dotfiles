layout {
    gaps 12
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#8aadf4"
        inactive-color "#494d64"
        urgent-color "#ed8796"
    }

    border {
        off
    }
}

animations { }
